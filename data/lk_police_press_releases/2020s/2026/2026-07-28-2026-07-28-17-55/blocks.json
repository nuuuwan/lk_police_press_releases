      412.7
    ],
    "text": "\u0bb9\u0baa\u0bcb\u0bb2\u0bbf\u0bb8\u0bcd \u0b8a\u0b9f\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bcb\u0bbf\u0bb5\u0bc1",
    "fonts": [
