    "text": "\u0b87\u0ba8\u0bcd\u0ba4 \u0b9a\u0b9f\u0bcd\u0b9f\u0bb5\u0bbf\u0bb0 \u0bcb\u0ba4 \u0b85\u0b95\u0bb4\u0bcd\u0bb5\u0bc1\u0baa\u0bcd \u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0ba8\u0bc0\u0ba3\u0bcd\u0b9f \u0b95\u0bcb\u0bb2\u0bae\u0bcb\u0b95 \u0bae\u0bc1\u0ba9\u0bcd\u0bb9\u0ba9\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bcb\u0b95\u0bb5\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0b95\u0bcb \u0ba3\u0bae\u0bcb\u0b95 \u0baa\u0bcb\u0bcb\u0bbf\u0baf \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0b9a\u0bcd\u0b9a\u0bc2\u0bb4\u0bb2\u0bcd \u0bb0\u0b9a\u0ba4\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bcb\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0b86 \u0bae\u0bcd\u0baa \u0bb5\u0bbf\u0b9a\u0bcb \u0b95\u0ba3\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bb9\u0ba4\u0bcb\u0bbf\u0baf\u0bb5\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.",
