    "text": "\u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dad\u0dca \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0da9\u0dd4 \u0db7\u0ddc\u0dab\u0dca\u0da9 \u0dc3\u0db8\u0d9f \u0dc4 \u0ddc\u0dbb\u0dab \u0dc4 \u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0dc3\u0dca\u0dae\u0ddc\u0db1\u0dba\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad. \u0dc4\u0db8\u0db8 \u0d9c\u0dd0\u0dbb\u0dd3\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0d9a\u0ddc\u0dd9\u0dba\u0d9a \u0dc3\u0dd2\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb, \u0dc4\u0dda \u0dc4 \u0dca\u0dad\u0dd4\u0dc4\u0dc0\u0db1\u0dca \u0daf\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad \u0dbb\u0dd2\u0dc3\u0dbb \u0dc0\u0dd2\u0db1\u0ddc\u0dc1\u0dba\u0d9a\u0dca\u0d9a \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0daf \u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dc2\u0dab\u0dba \u0dc0\u0dd3 \u0d87\u0dad. \u0dc4\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dc4\u0dba\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1 \u0dc4 \u0ddc\u0dbb\u0dab \u0dc4 \u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0dc3\u0dca\u0dae\u0ddc\u0db1\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dd9\u0db6\u0dba\u0dd2. \u0dbb\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dca \u0db8\u0dcf\u0db0\u0dba \u0dbb\u0d9a\u0dcf\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba.",
