    "text": "\u0d89\u0dc4\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d85\u0db1\u0dd4 \u0db8\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca\u0dad \u0db8\u0dc4\u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0d9c\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0d85 \u0dc4\u0dc3\u0dd4\u0dad\u0ddc\u0dc0\u0dba\u0db1\u0dca\u0dad\u0da7 \u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dc0\u0dc0\u0dd3\u0db8 \u0d85\u0dc0\u0db8 \u0d9a\u0dbb \u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0dc3\u0dba\u0dd2\u0db6\u0dbb\u0dca \u0d85 \u0dbb\u0ddc\u0db0\u0dca\u200d \u0d85\u0dc0\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dd2\u0dc1\u0ddc\u0dbd \u0db4\u0dd2\u0da7\u0dd4\u0dc0\u0dc4\u0dbd\u0d9a\u0dca\u0dc0 \u0dc0\u0db1\u0dd4 \u0d87\u0dad. \u0d9c\u0db8\u0db8 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9c\u0db8\u0dba\u0da7 \u0d9c \u0dbb \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0ddc\u0dc0\u0d9a\u0daf\u0dd3 \u0daf \u0db8\u0dc4\u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dbb \u0db8\u0dc4\u0da2\u0db1\u0dad\u0ddc\u0dc0\u0d9c\u0dda \u0daf\u0dd0\u0db1 \u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0d89\u0dc4\u0dad \u0db1\u0dd2\u0d9c\u0dda\u0daf\u0db1\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dc0\u0dad\u0dad\u0dca \u0d94\u0db6 \u0db8\u0ddc\u0db0\u0dca\u200d\u0dba \u0d86\u0dba\u0dad\u0db1\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0da0\u0ddc\u0dbb\u0dba\u0d9a\u0dca\u0dc0 \u0dbd\u0db6\u0ddc \u0d9c\u0daf\u0db1 \u0d9c\u0db8\u0db1\u0dca\u0dad \u0d9a\u0ddc\u0dbb\u0dd4\u0dab\u0dd2\u0d9a\u0dc0 \u0d89\u0dbd\u0dca\u0dbd\u0ddc \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2. \u0d9c \u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0db8\u0ddc\u0db0\u0dca\u200d\u0dba \u0d9c\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0ddc\u0dc3\u0dba.",
