    "text": "\u0b87\u0bc6\u0bcd \u0bc6\u0bbf\u0b9a\u0bb2\u0b9a\u0bae\u0b9a\u0baf\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0b95\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1, \u0b87\u0bb5\u0bcd\u0bb5\u0bb0\u0bb1\u0bb0\u0ba9 \u0ba4\u0bb5\u0bb1\u0bb0\u0b95 \u0bb5\u0bb4\u0bbf\u0bc6\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0ba4\u0bc8\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb5\u0bb1\u0bcd\u0bb1\u0bc1\u0b9f\u0ba9\u0bcd \u0ba4\u0ba4\u0bb0\u0b9f\u0bb0\u0bcd\u0baa\u0bc1\u0b9a\u0b9f\u0baf \u0b9a\u0bc8\u0baa\u0bb0\u0bcd \u0b85\u0bc8\u0bcd\u0b9a\u0bc1\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bb0\u0ba9 (Phishing and Online Scams) \u0baa\u0bae\u0bb0\u0bc8\u0b9f\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0bc6\u0bcd\u0ba4\u0bc1 \u0ba4\u0b99\u0bcd\u0b95\u0b9a\u0bb3\u0baa\u0bcd \u0baa\u0bb0\u0ba4\u0bc1\u0b95\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bb0\u0bb3\u0bcd\u0bb3, \u0ba4\u0baa\u0bb0\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0b86\u0baa\u0bb2\u0bb0\u0bc8\u0b9a\u0ba9\u0b95\u0b9a\u0bb3\u0baa\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bb0\u0bb1\u0bc1 \u0b87\u0bb2\u0b99\u0bcd\u0b9a\u0b95 \u0ba4\u0baa\u0bb0\u0bb2\u0bbf\u0bc8\u0bb0\u0bb0\u0bcd \u0baa\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bb0\u0bb3\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9\u0bb0\u0bcd.",
