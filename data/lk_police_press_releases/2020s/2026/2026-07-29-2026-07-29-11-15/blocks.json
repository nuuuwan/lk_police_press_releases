    "text": "\u0db1\u0dcf\u0db3\u0dd4\u0db1\u0db1 \u0db8\u0dd8\u0dad \u0dc1\u0dbb\u0dd3\u0dbb\u0dba\u0d9a\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dc4\u0da2\u0db1 \u0dc3\u0dc4\u0dba \u0db4\u0dd0\u0dad\u0dd3\u0db8. 2026.07.17 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0db8\u0dd3\u0dbb\u0dd2\u0d9c\u0db8 \u0db4\u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0dc0\u0dc3\u0db4\u0dda \u0d9c\u0dd2\u0dbb\u0dd2\u0d8b\u0dbd\u0dca\u0dbd \u0db4\u0dc3\u0dca\u0dba\u0ddc\u0dbd \u0db8\u0ddc\u0dbb\u0dca\u0d9c\u0db4\u0dda \u0d89\u0daf\u0dd2\u0db4\u0dbb\u0db4\u0dda \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1\u0db4\u0dda\u0daf\u0dd3 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd6 \u0dbb\u0dd2\u0dba \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0d9a\u0dd2\u0db1\u0dca \u0db6\u0dbb\u0db4\u0dad\u0dbd \u0dad\u0dd4\u0dc0\u0ddc\u0dbd \u0dbd\u0dd0\u0db6\u0dd6 \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0db4\u0dba\u0d9a\u0dd4 \u0d91\u0db8 \u0dc3\u0dca\u0dae\u0ddc\u0db1\u0db4\u0dda\u0daf\u0dd3\u0db8 \u0db8\u0dd2\u0dba \u0db4\u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad. \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0db8\u0dd8\u0dad \u0dc1\u0dbb\u0dd3\u0dbb\u0dba \u0dc4\u0db3\u0dd4\u0db1\u0ddc\u0d9c\u0dad \u0db4\u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2 \u0d86\u0d9a\u0ddc\u0dbb\u0dba\u0da7 \u0daf\u0dd0\u0da9\u0dd2 \u0dc4\u0ddc\u0db1\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0db8\u0dbb\u0dab\u0d9a\u0dbb\u0dd4\u0db4\u0dda \u0d85\u0db1\u0db1\u0dba\u0dad\u0ddc\u0dc0\u0dba \u0db4\u0db8\u0db4\u0dad\u0d9a\u0dca \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0db4\u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd3 \u0d87\u0dad. \u0db8\u0dbb\u0dab\u0d9a\u0dbb\u0dd4 \u0dc0\u0dba\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 55 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0db4\u0db4\u0db1\u0dd4\u0db8 \u0d87\u0dad\u0dd2 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0db4\u0dd4\u0dbb\u0ddc \u0dbb\u0dd0\u0dc0\u0dd4\u0dbd \u0dc0\u0dc0\u0ddc \u0d87\u0dad\u0dd2 \u0d8b\u0dc3 \u0d85\u0da9\u0dd2 05 \u0d85\u0d9f\u0dbd\u0dca 02 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0db4\u0dba\u0d9a\u0dd2. \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dbb\u0da7 \u0dbd\u0ddc \u0db4\u0d9a\u0ddc\u0dc5 \u0db4\u0dd0\u0dc4\u0dd0\u0dba\u0da7 \u0dc4\u0dd4\u0dbb\u0dd4 \u0daf\u0dd2\u0d9c \u0d9a\u0dbd\u0dd2\u0dc3\u0db8\u0d9a\u0dca \u0dc4\u0ddc \u0d91\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dad\u0dd2 \u0d85\u0dad\u0dca \u0db4\u0d9a\u0ddc\u0da7 \u0da7\u0dd3 \u0dc2\u0dbb\u0dca\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0dd0\u0db3 \u0dc3\u0dd2\u0da7\u0dd3. \u0db8\u0dd8\u0dad \u0dc1\u0dbb\u0dd3\u0dbb\u0dba \u0dc0\u0dad\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dc0\u0dbd \u0db4\u0dbb\u0ddd\u0dc4\u0db4\u0dbd\u0dca \u0db8\u0dd8\u0dad \u0dc1\u0dbb\u0dd3\u0dbb\u0ddc\u0d9c\u0ddc\u0dbb\u0db4\u0dda \u0dad\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0db4\u0db8\u0db8 \u0db8\u0dbb\u0dab\u0d9a\u0dbb\u0dd4 \u0dc4\u0db3\u0dd4\u0db1\u0ddc\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0d94\u0db6 \u0db8\u0ddc\u0db0\u0dca\u200d\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0da0\u0ddc\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0ddc \u0daf\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db4\u0db8\u0db1\u0dca \u0d9a\u0ddc\u0dbb\u0dd4\u0dab\u0dd2\u0d9a\u0dc0 \u0d89\u0dbd\u0dca\u0dbd\u0ddc \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2. \u0db8\u0dbb\u0dab\u0d9a\u0dbb\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dba\u0dda \u0db4\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0d9a\u0dca \u0db4\u0dc0\u0db4\u0dad\u0ddc\u0dad\u0dca \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0daf\u0dd4\u0dbb\u0d9a\u0dae\u0db1 \u0d85\u0d82\u0d9a \u0dc0\u0dbd\u0da7 \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0db4\u0daf\u0db1 \u0db4\u0dbd\u0dc3 \u0db4\u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba \u0db8\u0dc4\u0da2\u0db1\u0dad\u0ddc\u0dc0\u0db4\u0d9c\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0ddc \u0