    "bbox": [
      107.42,
      437.58,
      500.3,
      464.66
    ],
    "text": "Further investigations are being conducted by the Western Province North Crime Division.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      12.0
    ]
  },
