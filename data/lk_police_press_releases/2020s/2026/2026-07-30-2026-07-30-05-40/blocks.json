    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      72.02,
      306.5,
      526.91,
      473.42
    ],
    "text": "04. \u0dba\u0dad\u0dd4\u0dbb\u0dd4\u0db4\u0dd0\u0daf\u0dd2\u0dba\u0d9a\u0dca \u0dd9\u0dcf\u0dc4\u0db1\u0dba\u0d9a \u0d9c\u0dd0\u0da7\u0dd3 \u0db4\u0dd0\u0daf\u0dd2\u0d9a\u0dbb\u0dd4 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0da7 - \u0dd9\u0dda\u0db1\u0dd2\u0dba\u0dcf\u0dd9 \u0dc0\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dca \u0dd9\u0dc3\u0db8. 2026.07.29 \u0daf\u0dd2\u0db1 \u0d8b\u0daf\u0dd1\u0dc3\u0db1 \u0dd9\u0dda\u0db1\u0dd2\u0dba\u0dcf\u0dd9 \u0dc0\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dca \u0dd9\u0dc3\u0dc0\u0dda \u0db8\u0dc4\u0db1\u0dd4\u0dd9\u0dbb \u0dba\u0dcf\u0db4\u0db1\u0dba \u0d92 09 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dc0\u0dda \u0dad\u0dcf\u0db1\u0dca\u0da9\u0dd2\u0d9a\u0dd4\u0dbd\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dda\u0daf\u0dd3 \u0dd9\u0dda\u0db1\u0dd2\u0dba\u0dcf\u0dd9 \u0dc0\u0daf\u0dc3\u0da7 \u0db0\u0dcf\u0dd9\u0db1\u0dba \u0dc0\u0dd6 \u0dba\u0dad\u0dd4\u0dbb\u0dd4\u0db4\u0dd0\u0daf\u0dd2\u0dba\u0d9a\u0dca \u0d91\u0db8 \u0daf\u0dd2\u0dc3\u0dcf\u0dd9\u0da7\u0db8 \u0db0\u0dcf\u0dd9\u0db1\u0dba \u0dc0\u0dd6 \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0dc0\u0db1\u0dcf\u0d9c\u0dad\u0dca \u0dbb\u0dae\u0dba\u0d9a\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb \u0db4\u0dbd\u0dcf\u0dc0\u0d9c\u0dcf\u0dc3\u0dca \u0d87\u0dad. \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0db6\u0dbb\u0db4\u0dad\u0dbd \u0dad\u0dd4\u0dd9\u0dcf\u0dbd \u0dbd\u0dd0\u0db6\u0dd6 \u0dba\u0dad\u0dd4\u0dbb\u0dd4\u0db4\u0dd0\u0daf\u0dd2\u0d9a\u0dbb\u0dd4 \u0dd9\u0dda\u0db1\u0dd2\u0dba\u0dcf\u0dd9 \u0dc0\u0dbb\u0ddd\u0dc4\u0dbd\u0da7 \u0d87\u0dad\u0dd4\u0dbd\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc0\u0db8\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0db8\u0dd2\u0dba\u0dc0\u0d9c\u0dcf\u0dc3\u0dca \u0d87\u0dad. \u0db8\u0dbb\u0dab\u0d9a\u0dbb\u0dd4 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 64 \u0d9a\u0dca \u0dc0\u0dd6 \u0d9a\u0db1\u0d9c\u0dbb\u0dcf\u0dba\u0dda\u0d9a\u0dd4\u0dbd\u0dda \u0d8b\u0dad\u0dd4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dda \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0dd9\u0d9a\u0dd2. \u0dc3\u0dd2\u0dda\u0dd2\u0dba\u0da7 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0 \u0dd9\u0dcf\u0dc4\u0db1\u0dba \u0d85\u0db1\u0dad\u0dd4\u0dbb \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb \u0db4\u0dbd\u0dcf\u0dc0\u0d9c\u0dcf\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dd9\u0da7 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dda\u0db1\u0dd2\u0dba\u0dcf\u0dd9 \u0dc0\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dd2\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dd9\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2.",
