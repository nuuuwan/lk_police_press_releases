    "text": "\u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0b9f\u0bc1\u0b95\u0bca\u0baf\u0bae\u0bb2\u0b9f\u0ba8\u0bcd\u0ba4 \u0ba4\u0bae\u0bca\u0b9f\u0bcd\u0b9f\u0bca\u0bca\u0bcd \u0bb2\u0b9a\u0b95\u0bcd\u0b95\u0bbf\u0bb3\u0bcd \u0b9a\u0bca\u0bb0\u0ba4\u0bbf \u0bb5\u0bb5\u0bc1\u0ba9\u0bbf\u0baf\u0bca \u0bb2\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9a\u0bca\u0bb2\u0bb2\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bca\u0bcd \u0b89\u0baf\u0bbf\u0bca\u0bbf\u0bb4\u0ba8\u0bcd\u0ba4\u0bca\u0bca\u0bcd.",
