    ],
    "text": "02. \u0dc0\u0dc4\u0dc0\u0dbb\u0dcf\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0d9f \u0dc3\u0dd0\u0d9a\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dca \u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dd9\u0da7 - \u0dc0\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dd9\u0dba \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d82\u0dc1\u0dba. 2026.07.29 \u0daf\u0dd2\u0db1 \u0dbb\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0dcf\u0dbd\u0dc0\u0dda \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0db1\u0dca\u0dca\u0db4\u0dcf\u0dc3\u0dca \u0dc0\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dca \u0dd9\u0dc3\u0dc0\u0dda \u0dc0\u0dbd\u0dba\u0dcf\u0dc3\u0dca \u0dc0\u0dbb\u0ddd\u0dbb\u0dca\u0dca\u0dc0\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dda\u0daf\u0dd3 \u0dc0\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dd9\u0dba \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d82\u0dc1\u0dc0\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u0d9a\u0da7 \u0dbd\u0daf \u0dc0\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0d9a\u0dca \u0db8\u0dad \u0dd9\u0dd0\u0da7\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb \u0dc0\u0dc4\u0dc0\u0dbb\u0dcf\u0dba\u0dd2\u0db1\u0dca \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0dda 772 \u0d9a\u0dca \u0dc4\u0dcf \u0db8\u0dad\u0dca\u0dbb\u0dd9\u0dba \u0da2\u0dcf\u0dd9\u0dcf\u0dbb\u0dc0\u0db8\u0db1\u0dca \u0d8b\u0db4\u0dba\u0dcf \u0d9c\u0dad\u0dca \u0db6\u0dd9\u0da7 \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dbd \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dbd 75000/= \u0d9a\u0dca \u0dc3\u0db8\u0d9f \u0dc3\u0dd0\u0d9a\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dca \u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dd9\u0da7 \u0dc0\u0d9c\u0db1 \u0d87\u0dad. \u0dc3\u0dd0\u0d9a\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 38 \u0d9a\u0dca \u0dd9\u0db1 \u0dc0\u0d9a\u0dcf\u0dc5\u0db9 14 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dda \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dd2. \u0dc0\u0db4\u0dcf\u0dbd\u0dd2\u0dc3\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dd9\u0dba \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d82\u0dc1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dd9\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2.",
