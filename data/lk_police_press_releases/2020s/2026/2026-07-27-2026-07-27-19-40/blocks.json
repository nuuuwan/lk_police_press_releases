    "text": "\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0dd3\u0daf\u0dd2\u0dba, \u0d9c\u0dd1\u0dc3\u0dda\u0dd9\u0dc4 \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8, \u0db4\u0dca\u200d\u0dbb\u0db0\u0ddc\u0db1 \u0dd3\u0daf\u0dd2\u0dba, \u0d9b\u0ddc\u0db1\u0dca \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8, Y.M.B.A \u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dba, \u0d9a\u0dbd\u0dca\u0da9\u0dca\u0db1\u0db1\u0dca \u0db6\u0dd0\u0dc3\u0dda\u0da7\u0dd2\u0dba\u0db1\u0dca \u0db8\u0ddc\u0dc0\u0dad, \u0d9a\u0dba\u0ddd\u0dda\u0d9a\u0dca \u0dd3\u0daf\u0dd2\u0dba, \u0db6\u0ddc\u0d9a\u0dbb\u0ddd\u0db1\u0dca \u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0ddc\u0dc0\u0dad, \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0dd9\u0dad\u0dd2 \u0db8\u0ddc\u0dc0\u0dad, N.S.A \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8, \u0d9c\u0ddc\u0dbd\u0dd4 \u0db8\u0dd0\u0daf\u0dd9\u0ddc\u0dbb, \u0d9c\u0ddc\u0dbd\u0dd4 \u0db8\u0dd4\u0dc0\u0d9a\u0daf\u0ddc\u0dbb \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8, \u0d9c\u0ddc\u0dbd\u0dd4\u0dd9\u0ddc\u0dbb \u0d9a\u0d9a\u0ddc\u0dbd\u0dca\u0dbd\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dba \u0d94\u0dc3\u0dda\u0d9a\u0dc3\u0dda \u0db6\u0db8\u0dca\u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db1\u0dc0 \u0d9a\u0daf\u0dd2\u0d9a\u0dda\u0dc2\u0db1\u0dca \u0d9a\u0d9a\u0ddd\u0dc0\u0dd2\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0ddc. \u27a2 \u0d9a\u0dda\u0dbd\u0ddc\u0dc0\u0db1\u0dca \u0dc3\u0dc4 \u0d9c\u0db8\u0db1\u0dca \u0db8\u0ddc\u0dda\u0d9c\u0dba :-",
