    "text": "\u0db6\u0db8\u0dca\u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9a\u0d9a\u0ddd\u0dc0\u0dd2\u0dbd, \u0d9c\u0ddc\u0dbd\u0dd4\u0dd9\u0ddc\u0dbb \u0d94\u0dc3\u0dda\u0d9a\u0dc3\u0dda \u0d9c\u0ddc\u0dbd\u0dd4\u0db8\u0dd4\u0dc0\u0d9a\u0daf\u0ddc\u0dbb \u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0d9c\u0ddc\u0dbd\u0dd4 \u0db8\u0dd4\u0dc0\u0d9a\u0daf\u0ddc\u0dbb \u0d9a\u0dc3\u0db1\u0dca\u0dbb\u0dbd\u0dca \u0dd9\u0ddc\u0dbb, \u0da0\u0dd0\u0dad\u0dd0\u0db8\u0dca \u0dd3\u0daf\u0dd2\u0dba, \u0d9a\u0dba\u0ddc\u0dda\u0d9a\u0dca \u0dd3\u0daf\u0dd2\u0dba, \u0d9a\u0dbd\u0dca\u0da9\u0dca\u0db1\u0db1\u0dca \u0db6\u0dd0\u0dc3\u0dda\u0da7\u0dd2\u0dba\u0db1\u0dca \u0db8\u0ddc\u0dc0\u0dad, \u0db4\u0dca\u200d\u0dbb\u0db0\u0ddc\u0db1 \u0dd3\u0daf\u0dd2\u0dba, \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0dd3\u0daf\u0dd2\u0dba, \u0d9a\u0daf\u0dd2\u0d9a\u0dda\u0dc2\u0db1\u0dca \u0dd3\u0daf\u0dd2\u0dba, \u0db6\u0dca\u200d\u0dbb\u0ddc\u0dc3\u0dda\u0dc6\u0dc0\u0dd4\u0db1\u0dca\u0da9\u0dda \u0dd3\u0daf\u0dd2\u0dba, \u0d85\u0db1\u0dca\u0daf\u0dd2\u0d9a\u0dda\u0dbd\u0dca \u0dd3\u0daf\u0dd2\u0dba, \u0d9a\u0dba\u0dd2\u0db8\u0db1\u0dca \u0d9a\u0daf\u0ddc\u0dbb\u0da7\u0dd4\u0dc0 \u0d94\u0dc3\u0dda\u0d9a\u0dc3\u0dda \u0db4\u0dd2\u0da7\u0d9a\u0d9a\u0ddc\u0da7\u0dd4\u0dc0 \u0db1\u0dc0 \u0d9a\u0daf\u0dd2\u0d9a\u0dda\u0dc2\u0db1\u0dca \u0d9a\u0d9a\u0ddd\u0dc0\u0dd2\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0d89\u0dc4\u0dad \u0daf\u0dd2\u0db1\u0dba\u0db1\u0dca \u0dc4\u0ddc \u0d9a\u0dda\u0dbd\u0ddc\u0dc0\u0db1\u0dca\u0dd2 \u0d9a\u0dd9\u0dbb\u0dc4\u0dbb \u0d9c\u0db8\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0ddc \u0db8\u0ddc\u0dda\u0d9c \u0dc0\u0dbd \u0dba\u0db8\u0dca \u0dbb\u0dae\u0dc0\u0ddc\u0dc4\u0db1 \u0dad\u0daf\u0db6\u0daf\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0dc4\u0dd0\u0d9a\u0dd2\u0dad\u0ddc\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbd\u0dca\u0dd9 \u0db8\u0ddc\u0dda\u0d9c \u0db7\u0ddc\u0dc0\u0dd2\u0dad\u0ddc \u0d9a\u0dbb\u0db1 \u0d9a\u0dbd\u0dc3 \u0d9a\u0dd9\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba \u0dbb\u0dd2\u0dba\u0dd0\u0daf\u0dd4\u0dbb\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca \u0dc4\u0ddc \u0db8\u0dc4\u0da2\u0db1\u0dad\u0ddc\u0dc0\u0d9a\u0d9c\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0ddc \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dd2. \u0d89\u0dc4\u0dad \u0db1\u0dd2\u0d9a\u0dda\u0daf\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0dba\u0db1\u0dca \u0d94\u0db6 \u0db8\u0ddc\u0db0\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0da0\u0ddc\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0ddc \u0d9a\u0daf\u0db1 \u0d9a\u0db8\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0ddc \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2. \u0d9a\u0dd9\u0ddc\u0dbd\u0dd2\u0dc3\u0dda \u0db8\u0ddc\u0db0\u0dba \u0d9a\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0ddc\u0dc3\u0dba.",
