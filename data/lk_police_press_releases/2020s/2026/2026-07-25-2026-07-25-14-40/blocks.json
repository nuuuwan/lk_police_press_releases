    "text": "\u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dbb \u0ddd\u0db0\u0dd3 \u0dbb\u0dd9\u0dc3 \u0d8b\u0db4\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dd9\u0daf \u0dbb\u0dda\u0db4\u0dd9 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dd2 \u0dc4\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 - \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dbb \u0ddd\u0db0\u0dd3 \u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1 \u0dbb\u0d9a\u0dcf\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba. \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dbb\u0dda\u0dc1\u0dbb\u0dda \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0db4\u0dd4\u0dda\u0d9c\u0dd9\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0da2\u0dcf\u0dc0\u0dcf \u0db8 \u0dad\u0dd4\u0dbd\u0dd2\u0db1\u0dca \u0d8b\u0db4\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dd9\u0daf \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dbb\u0dd0\u0dc3\u0dca \u0d9a \u0dbb\u0d9c\u0db1 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0da7 \u0dd9\u0daf \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dca\u0dd9\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dbb\u0dba\u0db1\u0dca \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dbb \u0ddd\u0db0\u0dd3 \u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1 \u0dbb\u0d9a\u0dcf\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0d9a \u0d87\u0dad. \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1\u0dbb\u0dda\u0daf\u0dd3 \u0dbb\u0db8\u0db8 \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dbb \u0ddd\u0db0\u0dd3 \u0dbb\u0dd9\u0dc3 \u0d8b\u0db4\u0dba\u0dcf\u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dd9\u0daf \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dd9\u0d9a\u0dca